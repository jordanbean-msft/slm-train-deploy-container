{
  "resource_group_name": "${AZURE_RESOURCE_GROUP_NAME}",
  "location": "${AZURE_LOCATION}",
  "suffix": "${AZURE_ENV_NAME}",
  "acr_sku": "${AZURE_ACR_SKU}",
  "compute_vm_size": "${AZURE_COMPUTE_VM_SIZE}",
  "compute_min_instances": "${AZURE_COMPUTE_MIN_INSTANCES}",
  "compute_max_instances": "${AZURE_COMPUTE_MAX_INSTANCES}",
  "compute_idle_seconds": "${AZURE_COMPUTE_IDLE_SECONDS}",
  "tags": {
    "Environment": "${AZURE_ENV_NAME}",
    "ManagedBy": "azd",
    "SecurityControl": "Ignore"
  }
}
